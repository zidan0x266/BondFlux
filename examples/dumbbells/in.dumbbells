# Sciortino dumbbell benchmark for fix bond/flux 3body
# F. Sciortino, Eur. Phys. J. E 40, 3 (2017), Fig. 2:
#   400 A + 600 B, rho = 0.125, n = 100, rc = 1.3, kT = 0.03, lambda = 1
#   bond autocorrelation n_b(t) = exp(-t/tau) with tau = 116
# A-A and B-B: generalized WCA 4 eps [(s/r)^2n - (s/r)^n] + eps, cut at 2^(1/n) s
# A-B: two-body + three-body swap potential from fix bond/flux (pair style switched off)
#
# variables (set with -var): lambda (default 1.0), seed, teq / tprod (equilibration /
# production time)

variable        lambda index 1.0
variable        seed index 4265101
variable        teq index 1000.0
variable        tprod index 2000.0
variable        n equal 100
variable        kT equal 0.03
variable        dt equal 0.001

units           lj
atom_style      bond
boundary        p p p

region          box block 0 20 0 20 0 20
create_box      2 box bond/types 1
create_atoms    1 random 400 ${seed} box overlap 1.32 maxtry 100
create_atoms    2 random 600 $(v_seed+1) box overlap 1.32 maxtry 100
mass            * 1.0

pair_style      mie/cut $(2.0^(1.0/v_n))
pair_coeff      1 1 1.0 1.0 $(2*v_n) ${n}
pair_coeff      2 2 1.0 1.0 $(2*v_n) ${n}
pair_coeff      1 2 0.0 1.0 $(2*v_n) ${n}
pair_modify     shift yes

group           stick type 1 2
fix             tb stick bond/flux 3body 1.0 1.0 ${n} 1.3 ${lambda} bondable 1 2

comm_modify     cutoff 2.0
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create ${kT} $(v_seed+2) mom yes rot yes dist gaussian
timestep        ${dt}

# equilibration: dumbbells form, strong thermostat

fix             nve all nve
fix             lang all langevin ${kT} ${kT} 1.0 $(v_seed+3)
thermo_style    custom step temp pe f_tb f_tb[1] f_tb[2] f_tb[3] f_tb[4]
thermo_modify   norm no
thermo          20000
run             $(round(v_teq/v_dt))

# production: weak thermostat (damping time 100, as in the 3b-potentials example)

unfix           lang
fix             lang all langevin ${kT} ${kT} 100.0 $(v_seed+4)
reset_timestep  0
group           A type 1
dump            d A custom 1000 partners_lambda${lambda}.dump id f_tb[1] f_tb[2]
dump_modify     d sort id
run             $(round(v_tprod/v_dt))
