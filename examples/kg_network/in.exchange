# BondFlux example, stage 2: vitrimer-like exchange in the network of in.associate
#
# formation and breaking are switched off, so the number of dynamic bonds is
# conserved; only shift and swap exchanges change the topology.  The barrier Ea
# enters as the attempt gate exp(-Ea/kT), which slows the exchange without
# changing the equilibrium.  Partner IDs of all stickers are dumped every 1000
# steps for the bond autocorrelation (analyze_nb.py in ../dumbbells).
#
# contact diagnostics: every ncontact steps the fix checks which stickers have an
# exchange candidate; f_flux[16] (f_miss) is the fraction of contact episodes that no
# MC step saw and f_flux[15] (k_cond) the accepted exchanges per unit contact time.
# With MC every 100 steps about 40 % of the contacts are missed; -var nevery 10 resolves
# them (ncontact must divide nevery).  The checks use no random numbers, so they do not
# change the trajectory.

variable        seed index 777
variable        Ea index 0.0
variable        nsteps index 200000
variable        nevery index 100
variable        ncontact index 10

units           lj
atom_style      bond
boundary        p p p
read_data       network.data extra/bond/per/atom 2 extra/special/per/atom 4

special_bonds   lj/coul 0.0 1.0 1.0
bond_style      fene
bond_coeff      * 30.0 1.5 1.0 1.0
pair_style      lj/cut 1.122462048309373
pair_coeff      * * 1.0 1.0
pair_modify     shift yes

neighbor        0.4 bin
neigh_modify    every 1 delay 0 check yes
comm_modify     cutoff 3.2

group           stick type 2
fix             nve all nve
fix             lang all langevin 1.0 1.0 1.0 ${seed}
fix             flux stick bond/flux mc ${nevery} 2 1.3 1.0 $(v_seed+1) barrier ${Ea} &
                contact ${ncontact}

timestep        0.01
thermo_style    custom step temp pe press f_flux[10] f_flux[1] f_flux[3] f_flux[4] f_flux[8] &
                f_flux[15] f_flux[16]
thermo_modify   norm no
thermo          20000

dump            d stick custom 1000 partners_Ea${Ea}.dump id f_flux[1] f_flux[2]
dump_modify     d sort id
run             ${nsteps}
